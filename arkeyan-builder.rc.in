// 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST
1 24 "SSARecomp.manifest"

// The Details tab of the exe's properties (CMakeLists.txt fills in the version).
1 VERSIONINFO
FILEVERSION @SKYBUILD_VERSION_PARTS@
PRODUCTVERSION @SKYBUILD_VERSION_PARTS@
FILEOS 0x40004
FILETYPE 1
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904B0"
        {
            VALUE "FileDescription", "Arkeyan-Builder"
            VALUE "FileVersion", "@SSA_KIT_VERSION@"
            VALUE "InternalName", "Arkeyan-Builder"
            VALUE "OriginalFilename", "Arkeyan-Builder.exe"
            VALUE "ProductName", "Skylanders kit"
            VALUE "ProductVersion", "@SSA_KIT_VERSION@"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 0x4B0
    }
}
